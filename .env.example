# 백엔드 서버 포트
PORT=3001

# SQLite DB와 업로드 파일이 저장되는 디렉터리
DATA_DIR=./data

# 최초 기동 시 users 테이블이 비어 있으면 이 값으로 관리자 계정을 만든다.
# ADMIN_PASSWORD 가 없으면 서버가 기동에 실패한다 (최초 1회 필수).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# HTTPS 배포 시 true 로 바꾼다 (세션 쿠키 Secure 플래그)
COOKIE_SECURE=false

# 프론트엔드 공개 주소 (개발 중에는 Vite dev 서버)
PUBLIC_URL=http://localhost:5173

# development | production | test
NODE_ENV=development
