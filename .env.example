# 백엔드 서버 포트
PORT=3001

# SQLite DB와 업로드 파일이 저장되는 디렉터리
DATA_DIR=./data

# 최초 기동 시 users 테이블이 비어 있으면 이 값으로 관리자 계정을 만든다.
# ADMIN_PASSWORD 가 없으면 서버가 기동에 실패한다 (최초 1회 필수).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# HTTPS 배포 시 true 로 바꾼다 (세션 쿠키 Secure 플래그)
COOKIE_SECURE=false

# 리버스 프록시 신뢰 설정 (기본 false — X-Forwarded-For 를 무시한다).
# 기본값에서는 클라이언트가 보낸 X-Forwarded-For 로 로그인 rate limit 을 우회할 수 없다.
# DSM 리버스 프록시 뒤에서 운영할 때는 TRUST_PROXY=1 (1홉만 신뢰) 로 설정한다.
# 프록시가 여러 대라면 홉 수(예: 2)나 신뢰할 IP/CIDR 목록(예: 127.0.0.1,10.0.0.0/8)도 쓸 수 있다.
TRUST_PROXY=false

# 프론트엔드 공개 주소 (개발 중에는 Vite dev 서버)
PUBLIC_URL=http://localhost:5173

# 실시간 협업 릴레이(excalidraw-room) 주소.
# 브라우저는 room 에 직접 붙지 않는다 — app 의 /socket.io 가 여기로 프록시하며
# 그 경계에서 세션 쿠키 인증을 검사하므로 room 은 루프백에만 열어 두면 된다.
ROOM_URL=http://127.0.0.1:3002

# development | production | test
NODE_ENV=development

# ---- AI 검색 카드 (M4) ---------------------------------------------------
# Gemini API 키. **서버에만** 둔다 (브라우저로 내려가지 않는다).
# 비어 있으면 AI 기능 전체가 꺼진다 — GET /api/ai/ping 이 {ai:false} 를 돌려주고 ✨ 버튼이 나오지 않는다.
GEMINI_API_KEY=

# 호출할 모델
GEMINI_MODEL=gemini-2.5-flash

# 업스트림 주소. 보통 바꾸지 않는다 (E2E 는 모킹 서버를 가리킨다).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 분당 퓨즈 — 사용자와 무관한 전체 합. 쿼터가 아니라 폭주 방지용이다.
AI_RATE_LIMIT_PER_MIN=20

# 댓글 WebSocket ping 주기(ms). 기본 30초 — 테스트에서만 줄인다.
COMMENT_WS_PING_MS=30000
