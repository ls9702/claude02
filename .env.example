# 백엔드 서버 포트
PORT=3001

# SQLite DB와 업로드 파일이 저장되는 디렉터리
DATA_DIR=./data

# 최초 기동 시 users 테이블이 비어 있으면 이 값으로 관리자 계정을 만든다.
# ADMIN_PASSWORD 가 없으면 서버가 기동에 실패한다 (최초 1회 필수).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# HTTPS 배포 시 true 로 바꾼다 (세션 쿠키 Secure 플래그)
COOKIE_SECURE=false

# 리버스 프록시 신뢰 설정 (기본 false — X-Forwarded-For 를 무시한다).
# 기본값에서는 클라이언트가 보낸 X-Forwarded-For 로 로그인 rate limit 을 우회할 수 없다.
# DSM 리버스 프록시 뒤에서 운영할 때는 TRUST_PROXY=1 (1홉만 신뢰) 로 설정한다.
# 프록시가 여러 대라면 홉 수(예: 2)나 신뢰할 IP/CIDR 목록(예: 127.0.0.1,10.0.0.0/8)도 쓸 수 있다.
TRUST_PROXY=false

# 프론트엔드 공개 주소 (개발 중에는 Vite dev 서버)
PUBLIC_URL=http://localhost:5173

# development | production | test
NODE_ENV=development
