# NAS 배포용 환경변수 예시.
#
# 이 파일을 `.env` 로 복사해 값을 채운 뒤 docker-compose.yml 옆에 둔다.
#   cp .env.production.example .env
# `.env` 에는 비밀번호와 API 키가 들어가므로 **저장소에 올리지 않는다**.
# (Container Manager 의 프로젝트 화면에서도 같은 내용을 직접 입력할 수 있다.)

# ---- 필수 -----------------------------------------------------------------

# 최초 기동 때 만들어지는 관리자 계정의 비밀번호.
# 첫 로그인에서 반드시 변경하게 되어 있다(변경 전에는 다른 화면을 쓸 수 없다).
# 8자 이상. 변경 후에는 이 값이 더 이상 쓰이지 않지만, 지우지는 말 것 —
# 컨테이너가 재기동될 때마다 "관리자 계정이 없으면 만든다" 는 판단에 쓰인다.
ADMIN_PASSWORD=바꾸세요-8자이상

# 관리자 아이디 (기본 admin)
ADMIN_USERNAME=admin

# HTTPS 로 서비스하므로 세션 쿠키에 Secure 를 붙인다.
# HTTP 로 접속하면 쿠키가 저장되지 않아 로그인이 되지 않는다 — 반드시 도메인·인증서를 먼저 끝낼 것.
COOKIE_SECURE=true

# DSM 리버스 프록시 1홉만 신뢰한다 (X-Forwarded-For/Proto).
# 0/미설정이면 rate limit 이 모든 요청을 프록시 IP 하나로 묶어 버린다.
TRUST_PROXY=1

# 서비스 주소. CSP 의 WebSocket 오리진도 여기서 뽑는다.
PUBLIC_URL=https://draw.863ad.co.kr

NODE_ENV=production

# ---- AI (선택) ------------------------------------------------------------
# 비워 두면 AI 기능 전체가 꺼진다 (프론트에서 ✨ 버튼이 아예 나오지 않는다).
# 키는 **서버에만** 둔다 — 브라우저로 내려가지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 분당 호출 상한(사용자 무관 전체 합). 요금 폭주 방지용 퓨즈다.
AI_RATE_LIMIT_PER_MIN=20

# ---- 이미지 태그 ----------------------------------------------------------
# build-arm64.sh 가 찍어 주는 태그(`<git short sha>-<YYYYMMDD>`)를 적는다.
# 업데이트할 때 여기만 바꾸고 프로젝트를 다시 빌드/시작하면 된다 (OPERATIONS.md).
APP_TAG=latest
ROOM_TAG=latest
