# 라즈베리파이4 배포용 환경변수 예시 (deploy/pi).
#
# 이 파일을 `.env` 로 복사해 값을 채운 뒤 docker-compose.yml 옆에 둔다.
#   cp .env.example .env
# `.env` 에는 비밀번호와 API 키·터널 토큰이 들어가므로 **저장소에 올리지 않는다**
# (저장소 루트 .gitignore 의 `.env` 규칙이 이 파일도 걸러 준다).
#   chmod 600 .env
#
# NAS 용 `.env.production.example` 의 항목을 모두 포함하고, Pi 에만 필요한
# Caddy·백업·터널 설정이 추가돼 있다.

# ===========================================================================
# 1. 앱 — 필수
# ===========================================================================

# 최초 기동 때 만들어지는 관리자 계정의 비밀번호.
# 첫 로그인에서 반드시 변경하게 되어 있다(변경 전에는 다른 화면을 쓸 수 없다).
# 8자 이상. 변경 후에는 이 값이 더 이상 쓰이지 않지만, 지우지는 말 것 —
# 컨테이너가 재기동될 때마다 "관리자 계정이 없으면 만든다" 는 판단에 쓰인다.
ADMIN_PASSWORD=바꾸세요-8자이상

# 관리자 아이디 (기본 admin)
ADMIN_USERNAME=admin

# HTTPS 로 서비스하므로 세션 쿠키에 Secure 를 붙인다.
# A안·B안 모두 브라우저가 보는 주소는 https 이므로 **둘 다 true** 다.
# HTTP 로 접속하면 쿠키가 저장되지 않아 로그인이 되지 않는다.
COOKIE_SECURE=true

# 프록시를 몇 홉 신뢰할지 (X-Forwarded-For / X-Forwarded-Proto).
# 0/미설정이면 rate limit 이 모든 요청을 프록시 IP 하나로 묶어 버린다.
#   A안: 1   (브라우저 → caddy → app)
#   B안: 2   (브라우저 → Cloudflare/cloudflared → caddy → app)
TRUST_PROXY=1

# 서비스 주소. CSP 의 WebSocket 오리진(wss://…)도 여기서 뽑는다.
PUBLIC_URL=https://draw.863ad.co.kr

NODE_ENV=production

# ---- AI (선택) ------------------------------------------------------------
# 비워 두면 AI 기능 전체가 꺼진다 (프론트에서 ✨ 버튼이 아예 나오지 않는다).
# 키는 **서버에만** 둔다 — 브라우저로 내려가지 않는다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 분당 호출 상한(사용자 무관 전체 합). 요금 폭주 방지용 퓨즈다.
AI_RATE_LIMIT_PER_MIN=20

# ---- 이미지 태그 ----------------------------------------------------------
# build-arm64.sh 가 찍어 주는 태그(`<git short sha>-<YYYYMMDD>`)를 적는다.
# Pi 에서 직접 빌드(docker-compose.build.yml)했다면 latest 그대로 둔다.
APP_TAG=latest
ROOM_TAG=latest

# 데이터 디렉터리(호스트 쪽). 기본은 이 폴더의 ./data.
# microSD 마모가 걱정되면 USB SSD 의 경로로 바꾼다 — 예: /mnt/ssd/whiteboard/data
# (SETUP-PI.md 10단계. 옮길 때는 컨테이너를 멈추고 내용을 통째로 복사한 뒤 바꾼다.)
DATA_DIR_HOST=./data

# ===========================================================================
# 2. 노출 방식 — A안 / B안 (SETUP-PI.md 6단계에서 택1)
# ===========================================================================

# Caddy 가 서비스할 주소.
#   A안: draw.863ad.co.kr   → Caddy 가 443 을 받고 인증서를 자동 발급한다
#   B안: :80                → cloudflared 가 TLS 를 맡고 Caddy 는 평문 80 만 받는다
SITE_ADDRESS=draw.863ad.co.kr

# Let's Encrypt 만료·문제 알림을 받을 주소 (A안에서 실제로 쓰인다).
# **자기 메일 주소로 바꿀 것.** 아무 주소나 넣으면 인증서 만료 경고를 못 받는다.
CADDY_EMAIL=admin@863ad.co.kr

# A안에서 NAS 호스트명을 NAS 로 되돌려 줄 때 쓰는 NAS 의 LAN IP.
# 공유기1 에서 NAS 에 DHCP 예약을 걸어 둔 그 주소다. Caddyfile 의 주석 블록 참고.
NAS_IP=192.168.1.100

# B안 전용 — Cloudflare Zero Trust 에서 터널을 만들면 나오는 토큰.
# `docker compose --profile tunnel up -d` 로 띄울 때만 쓰인다.
# 이 토큰 하나로 터널에 접속할 수 있으므로 비밀번호처럼 다룬다.
CLOUDFLARE_TUNNEL_TOKEN=

# ===========================================================================
# 3. NAS 백업 (backup-to-nas.sh · whiteboard-backup.timer)
# ===========================================================================

# 앱 주소. 컨테이너 밖(호스트)에서 부르므로 공개 주소를 쓴다.
# 집 안에서 공개 도메인이 안 풀리면(헤어핀 NAT 미지원) A안은 http://127.0.0.1:80 이
# Caddy 로 들어가지만 호스트명이 달라 404 가 난다 — 그럴 때는
# `curl --resolve draw.863ad.co.kr:443:127.0.0.1` 대신 아래를 그대로 두고
# /etc/hosts 에 `127.0.0.1 draw.863ad.co.kr` 를 넣는 편이 간단하다.
BACKUP_BASE_URL=https://draw.863ad.co.kr

# 백업 API(`POST /api/admin/backup`)를 부를 관리자 계정.
# 위의 ADMIN_PASSWORD 는 최초 1회용이라 첫 로그인에서 바꾸고 나면 더 이상 맞지 않는다.
# 그래서 여기에는 **변경한 실제 비밀번호**를 넣거나, 백업 전용 관리자 계정을 하나 더
# 만들어 그 계정을 쓴다(새 계정은 최초 1회 웹에서 로그인해 비밀번호를 바꿔야 API 가 열린다).
BACKUP_ADMIN_USERNAME=admin
BACKUP_ADMIN_PASSWORD=

# TLS 검증을 건너뛸지 (기본 0). 사설 인증서로 내부 주소를 부를 때만 1 로 둔다.
BACKUP_INSECURE=0

# ---- 전송 방식: ssh(권장) 또는 mount --------------------------------------
#   ssh   : rsync -e ssh 로 NAS 에 직접 보낸다. NAS 에서 SSH 를 켜고 키를 등록해야 한다.
#   mount : 이미 마운트돼 있는 경로(SMB/NFS)로 복사한다. NAS SSH 를 켜지 않아도 된다.
BACKUP_MODE=ssh

# --- BACKUP_MODE=ssh 일 때 ---
NAS_SSH_HOST=192.168.1.100
NAS_SSH_PORT=22
NAS_SSH_USER=whiteboard-backup
# 비밀번호 없는 전용 키. `ssh-keygen -t ed25519 -f ~/.ssh/nas_backup -N ""` 로 만들고
# 공개키를 NAS 계정의 ~/.ssh/authorized_keys 에 넣는다 (SETUP-PI.md 9단계).
NAS_SSH_KEY=/home/pi/.ssh/nas_backup
# NAS 쪽 목적지 디렉터리 (공유 폴더 안의 경로).
NAS_DEST=/volume1/backup/whiteboard

# --- BACKUP_MODE=mount 일 때 ---
# Pi 에 마운트해 둔 NAS 공유 폴더 경로 (/etc/fstab 로 부팅 시 자동 마운트 권장).
NAS_MOUNT_DEST=/mnt/nas/backup/whiteboard

# 백업 실행 후 NAS 에 남길 DB 스냅샷 개수(0 이면 정리하지 않는다).
# 앱 자체도 data/backup/ 에 최신 7개만 남긴다 — 여기는 NAS 쪽 보관 개수다.
NAS_KEEP=30

# ===========================================================================
# 4. compose 편의
# ===========================================================================
# B안을 쓸 때 매번 --profile tunnel 을 붙이기 싫으면 아래 주석을 푼다.
# COMPOSE_PROFILES=tunnel
