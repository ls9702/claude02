# 매일 새벽 3시에 whiteboard-backup.service 를 돌린다.
#
#   sudo systemctl enable --now whiteboard-backup.timer
#   systemctl list-timers whiteboard-backup.timer     # 다음 실행 시각 확인

[Unit]
Description=Daily whiteboard backup to NAS (03:00)

[Timer]
# 시스템 로컬 시간 기준. Pi 의 시간대가 맞는지 확인할 것: timedatectl
# (Asia/Seoul 이 아니면: sudo timedatectl set-timezone Asia/Seoul)
OnCalendar=*-*-* 03:00:00

# Pi 가 꺼져 있어 놓친 실행은 다음 부팅 뒤에 한 번 따라잡는다.
Persistent=true

# 정확히 03:00 에 몰리지 않게 0~10분 사이로 흩뜨린다.
RandomizedDelaySec=10min

Unit=whiteboard-backup.service

[Install]
WantedBy=timers.target
