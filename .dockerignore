# 빌드 컨텍스트에서 뺄 것 (backend/Dockerfile · room/Dockerfile 공용).
# 컨텍스트가 작아야 크로스 빌드(QEMU) 전송이 빨라지고, 로컬 산출물이 이미지로 새지 않는다.

# 의존성 — 이미지 안에서 npm ci 로 다시 설치한다
# (호스트가 x86_64 면 better-sqlite3 네이티브 바이너리를 arm64 에서 쓸 수 없다).
**/node_modules

# 빌드 산출물 — 이미지 안에서 다시 만든다
backend/dist
room/dist
frontend/dist
frontend/public/excalidraw-assets

# 로컬 데이터 · 비밀
data
**/data
**/.env
**/.env.local
**/.env.production
**/*.db
**/*.db-wal
**/*.db-shm

# 테스트 산출물
e2e/.state
e2e/.state-prod
e2e/.tmp
e2e/test-results
e2e/test-results-prod
e2e/playwright-report
coverage

# 개발 도구 · 편집기 · VCS
.git
.gitignore
.github
.vscode
.idea
.claude
**/*.log

# 문서 · 배포 스크립트 (이미지에 필요 없다)
*.md
backend/Dockerfile
room/Dockerfile
.dockerignore
docker-compose.yml
build-arm64.sh
dist-images
